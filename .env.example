# Copie para .env.local (que está no .gitignore) e preencha.
# No Netlify, cadastre as mesmas variáveis em Site configuration > Environment variables
# e refaça o deploy: as NEXT_PUBLIC_ viram valor fixo no build.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Texto do plano de pagamento (opcional; sem chave o botão avisa).
GEMINI_API_KEY=
GEMINI_MODEL=

# Só para os scripts de manutenção (migrações, importações).
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.xxxxxxxx.supabase.co:5432/postgres
